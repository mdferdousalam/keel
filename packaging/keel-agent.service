# A *user* unit. Enable with `systemctl --user enable --now keel-agent`.
#
# Never a system unit: the agent holds one user's keys, and one process holding several users'
# vaults would undo the reason the agent exists.
#
# Starting it is optional. Any Keel client will start the agent on demand, and this unit exists
# only for people who prefer it under the service manager.
[Unit]
Description=Keel password manager agent
Documentation=https://github.com/mdferdousalam/keel
# The agent needs a session to find its runtime directory and to observe screen-lock events.
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/keel-agent
Restart=on-failure
RestartSec=2

# The agent's own hardening runs in-process before any key exists — locked pages, core dumps
# off, ptrace denied. These are the parts the service manager can add on top.
NoNewPrivileges=true
# Core dumps would write key material to disk. The agent also sets RLIMIT_CORE itself; this is
# the belt to that braces.
LimitCORE=0
# The agent needs to lock pages containing keys. The usual default is a few megabytes, which is
# plenty for keys and not for a large decrypted manifest — see the threat model on why the real
# mitigation is keeping the decrypted footprint small.
LimitMEMLOCK=infinity
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-write
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true
# Keel links no network stack. Denying address families makes that a kernel-enforced property
# rather than a claim about the dependency graph.
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target
